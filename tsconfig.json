{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/components/*": [
        "./components/*"
      ],
      "@/context/*": [
        "./context/*"
      ],
      "@/styles": [
        "./styles"
      ],
      "@/styles/*": [
        "./styles/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/services/*": [
        "./src/services/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "context/**/*.ts",
    "context/**/*.tsx",
    "styles/**/*.ts",
    "styles/**/*.tsx",
    "src/data/**/*.ts",
    "src/data/**/*.tsx",
    "src/services/**/*.ts",
    "src/services/**/*.tsx",
    "src/types/**/*.ts",
    "src/types/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}